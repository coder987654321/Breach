<script>
  var NODES = {
    entry:     { name: 'ENTRY',     x: 55,  y: 200, status: 'breached', reward: 0,   duration: 0,    hashLen: 6,  file: "access_log.txt\nentry point compromised via default credentials.\npatch pending, audit flagged." },
    firewall:  { name: 'FIREWALL',  x: 175, y: 90,  status: 'locked',   reward: 150, duration: 2600, hashLen: 8,  file: "firewall_notes.log\nrule set outdated by 3 major versions.\ndeep packet inspection disabled for maintenance window." },
    proxy:     { name: 'PROXY',     x: 175, y: 310, status: 'locked',   reward: 150, duration: 3000, hashLen: 8,  file: "proxy_cache.log\ntraffic routed through 2 relay hops before reaching subnet.\nrelay B logging disabled since last patch." },
    database:  { name: 'DATABASE',  x: 320, y: 200, status: 'locked',  reward: 350, duration: 4200, hashLen: 12, file: "db_schema.sql\nuser table contains 40k+ records.\nbackup key stored in mainframe vault, cross-reference required." },
    mainframe: { name: 'MAINFRAME', x: 435, y: 200, status: 'locked',  reward: 950, duration: 6000, hashLen: 16, file: "vault_manifest.txt\nroot access confirmed. all subsystems under operator control.\nintrusion complete, clean exit recommended." }
  };

  var EDGES = [
    ['entry', 'firewall'],
    ['entry', 'proxy'],
    ['firewall', 'database'],
    ['proxy', 'database'],
    ['database', 'mainframe']
  ];

  var bootLines = [
    'BREACH:// secure shell v4.2',
    'establishing encrypted tunnel...',
    'tunnel established. 1 hop detected.',
    'welcome, operator. click a node to begin.'
  ];

  var connectedId = null;
  var credits = 0;
  var crackingInProgress = false;
  var audioCtx = null;

  var outputEl = document.getElementById('output');
  var graphLayer = document.getElementById('graphLayer');
  var objectiveEl = document.getElementById('objective');
  var creditsEl = document.getElementById('credits');
  var rankEl = document.getElementById('rank');
  var restartBtn = document.getElementById('restartBtn');

  function hexPoints(cx, cy, r) {
    var pts = [];
    for (var i = 0; i < 6; i++) {
      var angle = Math.PI / 180 * (60 * i - 30);
      var x = cx + r * Math.cos(angle);
      var y = cy + r * Math.sin(angle);
      pts.push(x.toFixed(1) + ',' + y.toFixed(1));
    }
    return pts.join(' ');
  }

  function isReachable(id) {
    for (var i = 0; i < EDGES.length; i++) {
      var a = EDGES[i][0];
      var b = EDGES[i][1];
      if (a === id && NODES[b].status === 'breached') return true;
      if (b === id && NODES[a].status === 'breached') return true;
    }
    return false;
  }

  function generateHash(len) {
    var chars = '0123456789ABCDEF';
    var out = '';
    for (var i = 0; i < len; i++) {
      out += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return out;
  }

  function rankFor(c) {
    if (c >= 1600) return 'ARCHITECT';
    if (c >= 900) return 'PHANTOM';
    if (c >= 450) return 'GHOST';
    if (c >= 150) return 'OPERATOR';
    return 'SCRIPT KID';
  }

  function playTone(freq, dur, type) {
    try {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      var osc = audioCtx.createOscillator();
      var gain = audioCtx.createGain();
      osc.type = type || 'sine';
      osc.frequency.value = freq;
      gain.gain.value = 0.05;
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + dur);
      osc.stop(audioCtx.currentTime + dur);
    } catch (e) {
      /* audio unavailable, ignore */
    }
  }

  function printLine(text, cls) {
    var el = document.createElement('div');
    el.className = 'line' + (cls ? ' ' + cls : '');
    el.textContent = text;
    outputEl.appendChild(el);
    outputEl.scrollTop = outputEl.scrollHeight;
  }

  function updateHeader() {
    creditsEl.textContent = credits;
    rankEl.textContent = rankFor(credits);
  }

  function updateObjective() {
    var ids = Object.keys(NODES);
    var targets = [];
    for (var i = 0; i < ids.length; i++) {
      var id = ids[i];
      if (NODES[id].status !== 'breached' && isReachable(id)) {
        targets.push(NODES[id].name);
      }
    }
    if (targets.length === 0) {
      var allBreached = true;
      for (var j = 0; j < ids.length; j++) {
        if (NODES[ids[j]].status !== 'breached') allBreached = false;
      }
      objectiveEl.textContent = allBreached ? 'all systems breached — you are ARCHITECT.' : 'no reachable targets right now.';
    } else {
      objectiveEl.textContent = 'click ' + targets.join(' or ') + ' to breach it';
    }
  }

  function makeClickHandler(id) {
    return function () { handleNodeClick(id); };
  }

  function renderNetwork() {
    graphLayer.innerHTML = '';
    for (var i = 0; i < EDGES.length; i++) {
      var a = EDGES[i][0];
      var b = EDGES[i][1];
      var na = NODES[a];
      var nb = NODES[b];
      var active = na.status === 'breached' || nb.status === 'breached';
      var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', na.x);
      line.setAttribute('y1', na.y);
      line.setAttribute('x2', nb.x);
      line.setAttribute('y2', nb.y);
      line.setAttribute('class', 'edge ' + (active ? 'active' : 'dim'));
      graphLayer.appendChild(line);
    }
    var ids = Object.keys(NODES);
    for (var k = 0; k < ids.length; k++) {
      var id = ids[k];
      var n = NODES[id];
      var statusClass = n.status === 'breached' ? 'breached' : (isReachable(id) ? 'reachable' : 'locked');
      var g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('class', 'node ' + statusClass);
      g.addEventListener('click', makeClickHandler(id));

      var poly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      poly.setAttribute('points', hexPoints(n.x, n.y, 32));
      poly.setAttribute('class', 'node-hex');
      g.appendChild(poly);

      var label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      label.setAttribute('x', n.x);
      label.setAttribute('y', n.y + 50);
      label.setAttribute('class', 'node-label');
      label.textContent = n.name;
      g.appendChild(label);

      if (id === connectedId && crackingInProgress) {
        var ring = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        ring.setAttribute('cx', n.x);
        ring.setAttribute('cy', n.y);
        ring.setAttribute('r', 42);
        ring.setAttribute('class', 'connect-ring');
        g.appendChild(ring);
      }
      graphLayer.appendChild(g);
    }
  }

  function handleNodeClick(id) {
    var node = NODES[id];
    if (node.status === 'breached') {
      printLine('--- ' + node.name + ' / recovered file ---', 'head');
      printLine(node.file, 'dim');
      return;
    }
    if (crackingInProgress) {
      printLine('already breaching another node — hang on.', 'warn');
      return;
    }
    if (!isReachable(id)) {
      printLine(node.name + ' is locked. breach a connected node first.', 'err');
      return;
    }
    connectedId = id;
    crackingInProgress = true;
    printLine('breaching ' + node.name + '...', 'head');
    renderNetwork();
    runCrackAnimation(id);
  }

  function runCrackAnimation(id) {
    var node = NODES[id];
    var block = document.createElement('div');
    block.className = 'line crack-block';

    var hashEl = document.createElement('div');
    hashEl.className = 'crack-hash';

    var barWrap = document.createElement('div');
    barWrap.className = 'crack-bar';
    var fillEl = document.createElement('div');
    fillEl.className = 'crack-fill';
    barWrap.appendChild(fillEl);

    var pctEl = document.createElement('div');
    pctEl.className = 'crack-pct';
    pctEl.textContent = '0%';

    block.appendChild(hashEl);
    block.appendChild(barWrap);
    block.appendChild(pctEl);
    outputEl.appendChild(block);
    outputEl.scrollTop = outputEl.scrollHeight;

    var start = Date.now();
    playTone(220, 0.08, 'square');

    var hashIv = setInterval(function () {
      hashEl.textContent = generateHash(node.hashLen);
    }, 80);

    var progIv = setInterval(function () {
      var elapsed = Date.now() - start;
      var pct = Math.min(100, Math.floor((elapsed / node.duration) * 100));
      fillEl.style.width = pct + '%';
      pctEl.textContent = pct + '%';
      if (elapsed >= node.duration) {
        clearInterval(hashIv);
        clearInterval(progIv);
        pctEl.textContent = '100%';
        finishCrack(id);
      }
    }, 60);
  }

  function finishCrack(id) {
    var node = NODES[id];
    node.status = 'breached';
    credits += node.reward;
    crackingInProgress = false;
    printLine('ACCESS GRANTED — ' + node.name + ' breached. +' + node.reward + ' credits', 'ok');
    playTone(660, 0.14, 'sine');
    renderNetwork();
    updateHeader();
    updateObjective();
    if (id === 'mainframe') {
      printWin();
    }
  }

  function printWin() {
    printLine('BREACH COMPLETE', 'head');
    printLine('mainframe compromised. rank: ARCHITECT. total credits: ' + credits, 'ok');
    printLine('hit restart to run it back.', 'dim');
  }

  function resetGame() {
    var ids = Object.keys(NODES);
    for (var i = 0; i < ids.length; i++) {
      if (ids[i] !== 'entry') NODES[ids[i]].status = 'locked';
    }
    credits = 0;
    connectedId = null;
    crackingInProgress = false;
    outputEl.innerHTML = '';
    updateHeader();
    updateObjective();
    renderNetwork();
    printLine('system reset. click a node to start again.', 'warn');
  }

  function typeBoot() {
    var lineIndex = 0;
    function nextLine() {
      if (lineIndex >= bootLines.length) {
        renderNetwork();
        updateHeader();
        updateObjective();
        return;
      }
      var text = bootLines[lineIndex];
      var charIndex = 0;
      var lineEl = document.createElement('div');
      lineEl.className = 'line boot';
      outputEl.appendChild(lineEl);
      var iv = setInterval(function () {
        lineEl.textContent += text.charAt(charIndex);
        charIndex++;
        outputEl.scrollTop = outputEl.scrollHeight;
        if (charIndex >= text.length) {
          clearInterval(iv);
          lineIndex++;
          setTimeout(nextLine, 220);
        }
      }, 16);
    }
    nextLine();
  }

  restartBtn.addEventListener('click', function () {
    resetGame();
  });

  typeBoot();
</script>
</body>
</html>
